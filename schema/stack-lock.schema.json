{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ubiubi18/idena-compat-stack/schema/stack-lock.schema.json",
  "title": "Idena legacy compatibility stack lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseId",
    "status",
    "legacyBaseline",
    "chainInvariants",
    "components",
    "toolchains",
    "artifacts",
    "consumerPins",
    "requiredGates",
    "gateResults"
  ],
  "properties": {
    "schema": {"const": 1},
    "releaseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "status": {"enum": ["candidate", "approved", "retired"]},
    "legacyBaseline": {"type": "object"},
    "chainInvariants": {"type": "object"},
    "components": {"type": "array", "minItems": 1},
    "toolchains": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1},
    "consumerPins": {"type": "object"},
    "requiredGates": {"type": "array", "minItems": 1, "uniqueItems": true},
    "gateResults": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence", "sha256"],
        "properties": {
          "status": {"const": "passed"},
          "evidence": {
            "type": "string",
            "pattern": "^compatibility/evidence/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
